{
  "name": "FP Talk 2026 Sandbox",
  "dockerComposeFile": "docker-compose.yml",
  "service": "sandbox",
  "workspaceFolder": "/sandbox",
  "shutdownAction": "stopCompose",
  "customizations": {
    "vscode": {
      "extensions": [
        "ocamllabs.ocaml-platform",
        "scala-lang.scala",
        "rust-lang.rust-analyzer",
        "ms-python.python"
      ]
    }
  },
  "postCreateCommand": "make build"
}
