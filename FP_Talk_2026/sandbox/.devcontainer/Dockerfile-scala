FROM debian:bookworm-slim
ARG TARGETARCH
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless curl ca-certificates gzip \
    && case "$TARGETARCH" in \
         amd64) SCALA_CLI_ARCH="x86_64" ;; \
         arm64) SCALA_CLI_ARCH="aarch64" ;; \
         *) echo "Unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
       esac \
    && curl -fsSL "https://github.com/VirtusLab/scala-cli/releases/latest/download/scala-cli-${SCALA_CLI_ARCH}-pc-linux.gz" \
       | gzip -d > /usr/local/bin/scala-cli \
    && chmod +x /usr/local/bin/scala-cli \
    && apt-get purge -y --auto-remove curl \
    && rm -rf /var/lib/apt/lists/*
# Прогрев: скачать компилятор Scala во время сборки образа, не во время доклада
RUN printf 'println("warmup")' > /tmp/warmup.sc \
    && scala-cli /tmp/warmup.sc \
    && rm /tmp/warmup.sc
WORKDIR /sandbox
